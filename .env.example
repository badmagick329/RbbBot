# Development only. Copy to .env; python -m rbb_bot.dev_start loads it.
# Production receives these settings from Dokploy. Never build secrets into images.
DB_URL=postgres://user:password@127.0.0.1:5432/rbb_dev
RBB_DISCORD_TOKEN=
RBB_REDDIT_CLIENT_ID=
RBB_REDDIT_CLIENT_SECRET=
RBB_REDDIT_USER_AGENT=
RBB_GOOGLE_SEARCH_KEY=
# Keep the existing key for an existing encrypted database.
RBB_DATA_ENCRYPTION_KEY=
RBB_OWNER_ID=
RBB_LOGGER_CHANNEL_ID=
RBB_CONFIRMATION_CHANNEL_ID=
RBB_CONFIRMATION_GUILD_ID=
RBB_DEBUG=true
RBB_DEFAULT_PREFIX=?
